{
  "name": "@hiai-gg/hiai-ui",
  "version": "0.1.3",
  "files": [
    "dist/",
    "!dist/__tests__/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiAi-gg/hiai-ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": "./dist/components/*",
    "./stores/*": "./dist/stores/*",
    "./lib/*": "./dist/lib/*",
    "./styles/*": "./dist/styles/*",
    "./components/ui/button/index": "./dist/components/ui/button/index.js",
    "./components/ui/dialog/index": "./dist/components/ui/dialog/index.js",
    "./components/ui/input/index": "./dist/components/ui/input/index.js",
    "./components/ui/tabs/index": "./dist/components/ui/tabs/index.js",
    "./components/ui/switch/index": "./dist/components/ui/switch/index.js",
    "./components/ui/dropdown-menu/index": "./dist/components/ui/dropdown-menu/index.js",
    "./components/ui/skeleton/index": "./dist/components/ui/skeleton/index.js",
    "./components/ui/sonner/index": "./dist/components/ui/sonner/index.js",
    "./components/ui/select/index": "./dist/components/ui/select/index.js",
    "./components/ui/popover/index": "./dist/components/ui/popover/index.js",
    "./components/ui/command/index": "./dist/components/ui/command/index.js",
    "./components/ui/combobox/index": "./dist/components/ui/combobox/index.js",
    "./components/ui/context-menu/index": "./dist/components/ui/context-menu/index.js",
    "./components/ui/menubar/index": "./dist/components/ui/menubar/index.js"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package -i src -o dist",
    "prepublishOnly": "bun run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node_modules/.bin/vitest run",
    "test:watch": "node_modules/.bin/vitest"
  },
  "dependencies": {
    "@tiptap/core": "^3.23.5",
    "@tiptap/extension-code-block-lowlight": "^3.18.0",
    "@tiptap/extension-highlight": "^3.18.0",
    "@tiptap/extension-image": "^3.18.0",
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/extension-list": "^3.18.0",
    "@tiptap/extension-table": "^3.18.0",
    "@tiptap/extension-text-align": "^3.18.0",
    "@tiptap/markdown": "^3.18.0",
    "@tiptap/pm": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "lowlight": "^3.3.0",
    "lucide-svelte": "^0.577.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.57.0",
    "svelte-sonner": "^0.3.28",
    "svelte-tiptap": "^3.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
