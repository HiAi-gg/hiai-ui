{
  "name": "@hiai-gg/hiai-ui",
  "version": "0.0.7",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiAi-gg/hiai-ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": "./dist/components/*",
    "./stores/*": "./dist/stores/*",
    "./lib/*": "./dist/lib/*",
    "./styles/*": "./dist/styles/*",
    "./components/ui/button/index": "./dist/components/ui/button/index.js",
    "./components/ui/dialog/index": "./dist/components/ui/dialog/index.js",
    "./components/ui/input/index": "./dist/components/ui/input/index.js",
    "./components/ui/tabs/index": "./dist/components/ui/tabs/index.js",
    "./components/ui/switch/index": "./dist/components/ui/switch/index.js",
    "./components/ui/dropdown-menu/index": "./dist/components/ui/dropdown-menu/index.js"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package -i src -o dist",
    "prepublishOnly": "bun run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "svelte": "^5.55.0",
    "@tiptap/core": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "@tiptap/pm": "^3.23.5",
    "@tiptap/markdown": "^3.18.0",
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/extension-highlight": "^3.18.0",
    "@tiptap/extension-code-block-lowlight": "^3.18.0",
    "@tiptap/extension-image": "^3.18.0",
    "@tiptap/extension-list": "^3.18.0",
    "@tiptap/extension-table": "^3.18.0",
    "@tiptap/extension-text-align": "^3.18.0",
    "svelte-tiptap": "^3.0.1",
    "bits-ui": "^2.18.1",
    "lucide-svelte": "^0.577.0",
    "shadcn-svelte": "^1.2.7",
    "lowlight": "^3.3.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.60.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  }
}
