{
  "name": "@hiai-gg/hiai-ui",
  "version": "0.0.3",
  "type": "module",
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HiAi-gg/hiai-ui"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/ui/*/index": "./src/components/ui/*/index.ts",
    "./components/ui/*": "./src/components/ui/*/index.ts",
    "./components/*": "./src/components/*",
    "./stores/*": "./src/stores/*",
    "./lib/*": "./src/lib/*",
    "./styles/*": "./src/styles/*"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-package",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "bits-ui": "^2.18.1",
    "lucide-svelte": "^0.577.0",
    "shadcn-svelte": "^1.2.7",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "peerDependencies": {
    "svelte": "^5.55.0",
    "@sveltejs/kit": "^2.65.0"
  },
  "devDependencies": {
    "svelte": "^5.55.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.65.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
